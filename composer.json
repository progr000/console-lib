{
  "name": "maksym/console-lib",
  "type": "library",
  "description": "console commands interface for small framework",
  "keywords": [
    "console",
    "command",
    "cmd",
    "run"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Maksym Haivoronskyi",
      "email": "maksym.haivoronskyi@gmail.com"
    }
  ],
  "require": {
    "php": ">=5.3.0",
    "ext-mbstring": "*",
    "maksym/log-lib": "@stable"
  },
  "require-dev": {
    "phpunit/phpunit": "@stable"
  },
  "autoload": {
    "psr-4": {
      "Maksym\\Console\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
